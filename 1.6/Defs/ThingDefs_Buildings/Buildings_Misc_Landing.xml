<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Shared fields of all Patient Landing Spot defs. -->
    <ThingDef ParentName="BuildingBase" Name="PatientLandingSpotBase" Abstract="True">
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <altitudeLayer>FloorEmplacement</altitudeLayer>
        <statBases>
            <WorkToBuild>0</WorkToBuild>
        </statBases>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <useHitPoints>False</useHitPoints>
        <designationCategory>Misc</designationCategory>
        <passability>Standable</passability>
        <canOverlapZones>true</canOverlapZones>
        <building>
            <isInert>true</isInert>
            <sowTag>SupportPlantsOnly</sowTag>
            <canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
            <wakeDormantPawnsOnConstruction>false</wakeDormantPawnsOnConstruction>
            <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
            <ai_chillDestination>false</ai_chillDestination>
            <ai_neverTrashThis>true</ai_neverTrashThis>
        </building>
    </ThingDef>

    <!-- Default 1x1 spot: always available. -->
    <ThingDef ParentName="PatientLandingSpotBase">
        <defName>PatientLandingSpot</defName>
        <label>patients land here</label>
        <description>Designates a spot where patients will be dropped.</description>
        <graphicData>
            <texPath>Things/Building/Misc/PartySpot</texPath>
        </graphicData>
        <uiOrder>2000</uiOrder>
        <modExtensions>
            <li Class="Hospital.Utilities.PatientLandingSpotExtension">
                <variant>false</variant>
            </li>
        </modExtensions>
    </ThingDef>

    <!-- Cosmetic variants (hidden by the mod setting "Show patient landing pads"). Odd square sizes only: the centre cell is where patients land. -->
    <DesignatorDropdownGroupDef>
        <defName>PatientLandingPads</defName>
        <label>patient landing pads</label>
        <useGridMenu>true</useGridMenu>
        <iconSource>Placed</iconSource>
    </DesignatorDropdownGroupDef>

    <ThingDef ParentName="PatientLandingSpotBase">
        <defName>PatientLandingPad_3x3_Tribal</defName>
        <label>patient landing pad (tribal, 3x3)</label>
        <description>A larger, purely cosmetic patient landing spot. Patients are dropped on the centre cell, exactly like on the default patient landing spot.</description>
        <graphicData>
            <texPath>Things/Building/Misc/PatientLandingPad/tribal_3x3</texPath>
            <drawSize>(3,3)</drawSize>
        </graphicData>
        <size>(3,3)</size>
        <rotatable>false</rotatable>
        <designatorDropdown>PatientLandingPads</designatorDropdown>
        <uiOrder>2001</uiOrder>
        <modExtensions>
            <li Class="Hospital.Utilities.PatientLandingSpotExtension">
                <variant>true</variant>
            </li>
        </modExtensions>
    </ThingDef>

